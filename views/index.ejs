<%- include('partials/header.ejs'); -%>

  <h1>📚 My Book Notes</h1>

  <% if (error) { %>
    <p class="notice notice-error"><%= error %></p>
  <% } %>
  <% if (message) { %>
    <p class="notice"><%= message %></p>
  <% } %>

  <div class="box">

    <form action="/add" method="post" class="panel book-form">
      <h2>Add a book</h2>
      <label class="field">
        <span>Title</span>
        <input type="text" name="title" placeholder="Book title" required>
      </label>
      <label class="field">
        <span>Author</span>
        <input type="text" name="author" placeholder="Author">
      </label>
      <label class="field">
        <span>Rating (0–10)</span>
        <input type="number" name="rating" min="0" max="10" step="1" placeholder="0–10" required>
      </label>
      <label class="field">
        <span>Notes</span>
        <textarea name="notes" placeholder="Notes"></textarea>
      </label>
      <div class="form-actions">
        <button type="submit" class="primary">➕ Add Book</button>
      </div>
    </form>

    <% if (!books.length) { %>
      <p class="empty">No books yet. Add a title and Open Library will fill in the cover when it finds a match.</p>
    <% } else { %>
      <h2 class="section-title">Your books</h2>
    <% } %>

    <% for (let book of books) { %>

      <article class="panel book-card">

        <% if (book.cover_url) { %>
          <img src="<%= book.cover_url %>" alt="Cover of <%= book.title %>">
        <% } else { %>
          <p class="no-cover">No Cover</p>
        <% } %>

        <div class="book-body">
          <h3 class="book-title" id="title-<%= book.id %>">
            <%= book.title %>
          </h3>
          <p class="book-author"><%= book.author || "Unknown" %></p>
          <p class="book-rating">Rating: <%= book.rating %>/10</p>
          <% if (book.notes) { %>
            <p class="book-notes"><%= book.notes %></p>
          <% } %>
          <% if (book.created_at) { %>
            <p class="book-meta">
              <%= book.created_at.toDateString() %> · <%= book.created_at.toLocaleTimeString() %>
            </p>
          <% } %>

          <div class="book-actions">
            <button type="button" class="secondary" onclick="toggleEdit(`<%= book.id %>`)">Edit</button>
            <form action="/delete" method="post">
              <input type="hidden" name="deleteBookId" value="<%= book.id %>">
              <button type="submit" class="danger">Delete</button>
            </form>
          </div>

          <form action="/edit" method="post" id="edit-<%= book.id %>" class="edit-form">
            <p class="edit-heading">Edit book</p>
            <input type="hidden" name="bookId" value="<%= book.id %>">
            <label class="field">
              <span>Title</span>
              <input type="text" name="title" value="<%= book.title %>" required>
            </label>
            <label class="field">
              <span>Author</span>
              <input type="text" name="author" value="<%= book.author || '' %>">
            </label>
            <label class="field">
              <span>Rating (0–10)</span>
              <input type="number" name="rating" value="<%= book.rating %>" min="0" max="10" step="1" placeholder="0–10" required>
            </label>
            <label class="field">
              <span>Notes</span>
              <textarea name="notes"><%= book.notes || '' %></textarea>
            </label>
            <div class="form-actions">
              <button type="submit" class="primary">Save</button>
              <button type="button" class="secondary" onclick="toggleEdit(`<%= book.id %>`)">Cancel</button>
            </div>
          </form>
        </div>

      </article>

    <% } %>

  </div>

  <script>
    function toggleEdit(id) {
      document.getElementById("edit-" + id).classList.toggle("is-open");
    }
  </script>

<%- include('partials/footer.ejs'); -%>
